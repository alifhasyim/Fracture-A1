\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Traction-separation curve based on the cohesive parameters defined in table~\ref {tab:CohesiveQ2}. The fracture energy is equivalent to the area of the triangle, which is $G_c = \frac  {1}{2}\sigma _n\delta _{fail} = 0.95 \text  { MPa.mm}$. The left side region of $G_c$ is the energy needed to reach the maximum stress criterion for the separation to initiate, while the right side area of triangle $G_c$ is the energy needs to separate completely the two cohesive elements. Hence, this area is divided with $\delta _0$, which simply the distance criterion to reach the $\sigma _n$ ($\delta _0 = \frac  {\sigma _n}{E}$).}}{15}{}\protected@file@percent }
\newlabel{fig:Q2_TractionSeparationCurve}{{15}{15}{}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces A half-cut mesh configuration for the cohesive zone model in question 2 for the top part geometry. A fine mesh is used around the cohesive area to accurately capture the stress distribution during crack propagation. The mesh size in the cohesive area is 0.01 mm, with an increase mesh transition of 2x of the element size, which at the neighboring elements is 0.02 mm and 0.04 mm respectively. This is used to ensure a smooth transition in the mesh size, while still maintaining accuracy around the cohesive zone and decrease computational cost for the non-prioritized regions.}}{16}{}\protected@file@percent }
\newlabel{fig:Q2_MeshConfiguration}{{16}{16}{}{figure.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Crack propagation plot showing the von Mises stress distribution at several load increments. The crack initiates and propagates along the cohesive surface through stages (c) to (f). Stage (a) and (b) shows the pre-crack initiation, indicating a constant stress distribution with an increase in its value before the crack initiates.}}{16}{}\protected@file@percent }
\newlabel{fig:Q2_CrackPropagationPlot}{{17}{16}{}{figure.17}{}}
\newlabel{eq:TotalReactionForce}{{15}{17}{}{equation.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Force-time response showing the total reaction force in the y-direction on the left edge of the upper part. The slope changes indicate crack initiation and propagation for stage 1 until stage 5.}}{17}{}\protected@file@percent }
\newlabel{fig:Q2_ForceTimeResponse}{{18}{17}{}{figure.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Plastic deformation around the crack tip during the crack propagation. The plastic deformation is observed to occur around the crack tip, indicating that the plate is undergoing plastic bending during the loading.}}{18}{}\protected@file@percent }
\newlabel{fig:Q2_CrackPlasticDeform}{{19}{18}{}{figure.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Comparison of traction values at three selected points along the cohesive surface with the analytical traction-separation curve.}}{19}{}\protected@file@percent }
\newlabel{fig:Q2_TractionSeparationComparison}{{20}{19}{}{figure.20}{}}
